<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="him_shop_pos_button.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <button t-if="!props.showRemainingButtons and !this.pos.isSmallProductScreen"
                t-att-disabled="this.pos.getOrder().isEmpty()"
                t-attf-class="{{ buttonClass }} text-truncate"
                t-on-click="() => this.pos.himSendToBar()">
                <i class="fa fa-print me-1"/>Gửi Bar
            </button>
        </xpath>
    </t>
</templates>
